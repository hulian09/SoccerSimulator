  if(state.minute===45){
    pushComment("HALF-TIME","ht");state.halfTime=true;updateScore();
    setTimeout(()=>{if(!state.finished){state.halfTime=false;pushComment("Second half underway.");updateScore();}},1200);
    return;
  }
  if(state.minute>=90){
    state.minute=90;state.finished=true;state.running=false;
    pushComment(`FULL-TIME — ${state.home} ${state.homeGoals}-${state.awayGoals} ${state.away}`,"ft");
    updateScore();if(state.interval)clearInterval(state.interval);state.interval=null;
    startBtn.disabled=false;startBtn.textContent="↻ Restart Match";
    showMatchSummary();return;
  }
  const home=TEAMS[state.home],away=TEAMS[state.away];
  const homeUrgency=attackingUrgency("home",state.minute),awayUrgency=attackingUrgency("away",state.minute);
  const homeWeight=home.attack*homeUrgency,awayWeight=away.attack*awayUrgency;
  const attackingSide=Math.random()<homeWeight/(homeWeight+awayWeight)?"home":"away";
  const defenderSide=attackingSide==="home"?"away":"home";
  state.stats[attackingSide].possession++;
  const attack=TEAMS[state[attackingSide]],defend=TEAMS[state[defenderSide]];
  const style=TEAM_STYLES[state[attackingSide]]||{creation:1,finishing:1,tempo:1};
  const defenderStyle=TEAM_STYLES[state[defenderSide]]||{creation:1,finishing:1,tempo:1};
  const attacker=choosePlayer(attackingSide,["LW","ST","ST2","RW","CAM","CM1","CM2","RWB","LWB"]);
  const keeper=choosePlayer(defenderSide,["GK"]);
  const ownGoals=attackingSide==="home"?state.homeGoals:state.awayGoals;
  const oppGoals=attackingSide==="home"?state.awayGoals:state.homeGoals;
  const trailing=ownGoals<oppGoals,leading=ownGoals>oppGoals;
  const strengthRatio=attack.attack/defend.defense;
  const tempo=matchTempo(state.minute)*style.tempo;
  const stateBoost=trailing?(state.minute>=75?1.18:1.08):(leading&&state.minute>=75?.94:1);
  const userGoalFactor=Number(goalRateSelect.value)||1;
  const chanceProbability=Math.max(.08,Math.min(.40,.225*tempo*Math.pow(strengthRatio,.25)*stateBoost*style.creation*userGoalFactor*(.90+Math.random()*.20)));
  if(attacker&&Math.random()<chanceProbability){
    state.stats[attackingSide].shots++;
    moveBallTo(attacker);
    const quality=chanceQuality();
    const roleFinishing={ST:1.12,ST2:1.12,LW:1.04,RW:1.04,CAM:.99,CM1:.90,CM2:.90,RWB:.80,LWB:.80};
    const conversionProbability=Math.max(.025,Math.min(.34,quality.conversion*Math.pow(strengthRatio,.45)*style.finishing*(roleFinishing[attacker.role]||.9)*(.80+Math.random()*.40)));
    const scoreAllowed=state.homeGoals+state.awayGoals<9&&ownGoals<7;
    if(scoreAllowed&&Math.random()<conversionProbability){goal(attackingSide);}
    else if(keeper&&Math.random()<quality.save){
      state.stats[attackingSide].onTarget++;state.stats[defenderSide].saves++;
      moveBallTo(keeper);pushComment(`Great save by ${lastName(keeper.name)} to deny ${lastName(attacker.name)}!`);
    }else{
      const miss=quality.label==="golden"?[`${lastName(attacker.name)} wastes a golden chance!`,`${lastName(attacker.name)} should do better — the shot flies wide.`][Math.floor(Math.random()*2)]:quality.label==="good"?[`${lastName(attacker.name)} fires wide from a good position.`,`${lastName(attacker.name)} is crowded out by the defence.`][Math.floor(Math.random()*2)]:[`${lastName(attacker.name)} tries from distance, but it sails over.`,`${lastName(attacker.name)} shoots from a tight angle and misses.`][Math.floor(Math.random()*2)];
      pushComment(miss);
    }
  }else{
    const events=[`${lastName(attacker?.name||"The midfield")} helps move the ball forward.`,`${state[attackingSide]} build patiently from midfield.`,`Good pressure from ${state[attackingSide]}.`,`The midfield battle is intense.`,`A promising attack develops, but the defence holds firm.`,`The ball is worked down the flank.`];
    if(attacker)moveBallTo(attacker);
    if(Math.random()<.68)pushComment(events[Math.floor(Math.random()*events.length)]);
  }
  updateScore();
}
function drawPitch(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const styles={classic:{top:"#2f8a49",bottom:"#236a39",stripe:0.035},stripes:{top:"#287d42",bottom:"#1e6535",stripe:0.075},night:{top:"#1b5b48",bottom:"#104737",stripe:0.055}};
  const pitchStyle=styles[pitchStyleSelect.value]||styles.classic;
  const gradient=ctx.createLinearGradient(0,0,0,PITCH.h);gradient.addColorStop(0,pitchStyle.top);gradient.addColorStop(1,pitchStyle.bottom);
  ctx.fillStyle=gradient;ctx.fillRect(0,0,PITCH.w,PITCH.h);
  const stripeW=PITCH.w/10;
  for(let i=0;i<10;i++){ctx.fillStyle=i%2===0?`rgba(255,255,255,${pitchStyle.stripe})`:`rgba(0,0,0,${pitchStyle.stripe*.72})`;ctx.fillRect(i*stripeW,0,stripeW,PITCH.h)}
  ctx.strokeStyle="rgba(255,255,255,.88)";ctx.lineWidth=2.5;
  ctx.strokeRect(18,18,PITCH.w-36,PITCH.h-36);
  ctx.beginPath();ctx.moveTo(PITCH.centerX,18);ctx.lineTo(PITCH.centerX,PITCH.h-18);ctx.stroke();
  ctx.beginPath();ctx.arc(PITCH.centerX,PITCH.centerY,82,0,Math.PI*2);ctx.stroke();
  ctx.beginPath();ctx.arc(PITCH.centerX,PITCH.centerY,4,0,Math.PI*2);ctx.fillStyle="#fff";ctx.fill();
  // Penalty areas share the goal-line baseline. Small boxes are fully inside the larger boxes.
  drawBox(18,180,145,260);drawBox(837,180,145,260);
  drawSmallBox(18,245,55,130);drawSmallBox(927,245,55,130);
  ctx.beginPath();ctx.arc(145,310,75,-Math.PI/2,Math.PI/2);ctx.stroke();
  ctx.beginPath();ctx.arc(855,310,75,Math.PI/2,Math.PI*1.5);ctx.stroke();
  ctx.beginPath();ctx.arc(128,310,3.5,0,Math.PI*2);ctx.fillStyle="rgba(255,255,255,.95)";ctx.fill();
  ctx.beginPath();ctx.arc(872,310,3.5,0,Math.PI*2);ctx.fill();
  drawGoal(-1);drawGoal(1);
  for(const player of state.players)drawPlayer(player);
  drawBall();
}
function drawBox(x,y,w,h){ctx.strokeRect(x,y,w,h)}function drawSmallBox(x,y,w,h){ctx.strokeRect(x,y,w,h)}
function drawGoal(side){
  // The frame sits exactly on the pitch end line; the net extends outwards, not into the playing area.
  const lineX=side<0?18:PITCH.w-18;
  const outerX=side<0?0:PITCH.w;
  const left=Math.min(lineX,outerX),width=Math.abs(lineX-outerX),top=245,height=130;
  ctx.save();ctx.fillStyle="rgba(235,245,250,.045)";ctx.fillRect(left,top,width,height);
  ctx.strokeStyle="rgba(250,252,255,.98)";ctx.lineWidth=3;ctx.strokeRect(left,top,width,height);
  ctx.strokeStyle="rgba(255,255,255,.28)";ctx.lineWidth=1;
  for(let i=1;i<6;i++){const y=top+i*(height/6);ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(left+width,y);ctx.stroke()}
  for(let i=1;i<3;i++){const x=left+i*(width/3);ctx.beginPath();ctx.moveTo(x,top);ctx.lineTo(x,top+height);ctx.stroke()}
  ctx.restore();
}
function drawPlayer(p){
  if(p.onPitch===false)return;
  const t=performance.now()/1000;
  const rawX=p.baseX+Math.sin(t*1.35+p.phase)*2.8;
  const x=p.side==="home"?Math.min(PITCH.centerX-48,rawX):Math.max(PITCH.centerX+48,rawX);
  const y=p.baseY+Math.cos(t*1.1+p.phase)*2.3;p.x=x;p.y=y;
  ctx.beginPath();ctx.arc(x,y,p.radius+3,0,Math.PI*2);ctx.fillStyle="rgba(0,0,0,.28)";ctx.fill();
  ctx.beginPath();ctx.arc(x,y,p.radius,0,Math.PI*2);ctx.fillStyle=p.color;ctx.fill();
  ctx.strokeStyle="rgba(255,255,255,.96)";ctx.lineWidth=2.3;ctx.stroke();
  const roleLabel=({CM1:"CM",CM2:"CM",ST2:"ST",CB:"CB"})[p.role]||p.role;
  ctx.font="900 9px Arial";ctx.textAlign="center";ctx.textBaseline="middle";ctx.fillStyle="#fff";ctx.fillText(roleLabel,x,y);
  if(showLabelsCheckbox.checked){
    const label=lastName(p.name).toUpperCase();let fs=11;while(fs>7){ctx.font=`850 ${fs}px Arial`;if(ctx.measureText(label).width<=78)break;fs--;}
    ctx.textAlign="center";ctx.textBaseline="top";ctx.lineWidth=3.5;ctx.strokeStyle="rgba(0,0,0,.86)";ctx.fillStyle="#fff";
    ctx.strokeText(label,x,y+23);ctx.fillText(label,x,y+23);
  }
}
function drawBall(){if(!state.ball)return;if(state.goalAnimation?.active){const a=state.goalAnimation,t=Math.min(1,(performance.now()-a.start)/a.duration),ease=1-Math.pow(1-t,3);drawBallAt(a.startX+(a.netX-a.startX)*ease,a.startY+(a.netY-a.startY)*ease,6);return}state.ball.x+=(state.ball.tx-state.ball.x)*.08;state.ball.y+=(state.ball.ty-state.ball.y)*.08;drawBallAt(state.ball.x,state.ball.y,6)}
function drawBallAt(x,y,r){ctx.beginPath();ctx.arc(x+2,y+2,r+1,0,Math.PI*2);ctx.fillStyle="rgba(0,0,0,.28)";ctx.fill();ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle="#fff";ctx.fill();ctx.strokeStyle="#111";ctx.lineWidth=1.5;ctx.stroke()}
function animationLoop(){drawPitch();requestAnimationFrame(animationLoop)}

function showMatchSummary(){
  const totalMinutes=Math.max(1,state.stats.home.possession+state.stats.away.possession);
  const homePoss=Math.round(100*state.stats.home.possession/totalMinutes);
  const awayPoss=100-homePoss;
  summaryTitle.textContent=`${state.home} vs ${state.away}`;
  summaryScore.textContent=`${state.homeGoals} – ${state.awayGoals}`;
  const cards=[
    ["Possession",`${homePoss}% – ${awayPoss}%`],
    ["Shots",`${state.stats.home.shots} – ${state.stats.away.shots}`],
    ["On target",`${state.stats.home.onTarget} – ${state.stats.away.onTarget}`],
    ["Saves",`${state.stats.home.saves} – ${state.stats.away.saves}`],
    ["Substitutions",`${state.stats.home.subs} – ${state.stats.away.subs}`]
  ];
  summaryStats.innerHTML=cards.map(([label,value])=>`<div class="stat-card"><div class="stat-value">${value}</div><div class="stat-label">${label}<br><span class="muted">Home – Away</span></div></div>`).join("");
  if(state.goalLog.length){
    summaryGoals.innerHTML=state.goalLog.map(g=>`<li><strong>${g.minute}′</strong> · ${g.scorer} <span class="muted">(${g.team})</span> <span class="muted">${g.score}</span></li>`).join("");
  }else summaryGoals.innerHTML='<li class="empty-state">No goals — a clean sheet for both sides.</li>';
  const keyEvents=state.matchEvents.filter(e=>["goal","sub","injury","ht","ft"].includes(e.type));
  const events=keyEvents.slice(-10).reverse();
  summaryEvents.innerHTML=events.length?events.map(e=>`<li><strong>${e.minute}′</strong> · ${escapeSummaryText(e.text)}</li>`).join(""):'<li class="empty-state">No major events recorded.</li>';
  matchSummary.hidden=false;
  matchSummary.scrollIntoView({behavior:"smooth",block:"nearest"});
}
function escapeSummaryText(text){return String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");}
function refreshMatchTimer(){
  if(state.interval)clearInterval(state.interval);
  state.interval=null;
  if(state.running&&!state.paused&&!state.finished)state.interval=setInterval(simulateMinute,Number(matchSpeedSelect.value)||500);
}
function resetMatch(){
  if(state.interval)clearInterval(state.interval);
  state={home:homeSelect.value,away:awaySelect.value,minute:0,homeGoals:0,awayGoals:0,running:false,paused:false,halfTime:false,finished:false,interval:null,players:[],ball:null,goalAnimation:null,stats:emptyStats(),goalLog:[],matchEvents:[],substitutionLog:[]};
  initSubState();setupPlayers();resetBall();clearCommentary();updateSquads();updateScore();
  matchSummary.hidden=true;pauseBtn.textContent="Ⅱ Pause";startBtn.textContent="▶ Start Match";startBtn.disabled=false;
  pushComment("Select the teams and press Start Match.");
}
function ensureDifferentTeams(){if(homeSelect.value===awaySelect.value){awaySelect.value=Object.keys(TEAMS).find(t=>t!==homeSelect.value)}}
function startMatch(){
  ensureDifferentTeams();
  if(state.running&&!state.finished)return;
  state.home=homeSelect.value;state.away=awaySelect.value;state.minute=0;state.homeGoals=0;state.awayGoals=0;
  state.running=true;state.paused=false;state.halfTime=false;state.finished=false;state.goalAnimation=null;
  state.stats=emptyStats();state.goalLog=[];state.matchEvents=[];state.substitutionLog=[];
  initSubState();setupPlayers();resetBall();clearCommentary();updateSquads();updateScore();
  matchSummary.hidden=true;startBtn.disabled=true;startBtn.textContent="● Match Running";pushComment(`Kick-off! ${state.home} vs ${state.away}.`);
  if(state.interval)clearInterval(state.interval);
  state.interval=setInterval(simulateMinute,Number(matchSpeedSelect.value)||500);
  pauseBtn.textContent="Ⅱ Pause";
}
function togglePause(){
  if(!state.running||state.finished)return;
  state.paused=!state.paused;
  pauseBtn.textContent=state.paused?"▶ Resume":"Ⅱ Pause";
  pushComment(state.paused?"Match paused.":"Match resumed.");updateScore();
}
homeSelect.addEventListener("change",()=>{ensureDifferentTeams();if(state.running)resetMatch();else{state.home=homeSelect.value;state.away=awaySelect.value;updateSquads();updateScore()}});
awaySelect.addEventListener("change",()=>{ensureDifferentTeams();if(state.running)resetMatch();else{state.home=homeSelect.value;state.away=awaySelect.value;updateSquads();updateScore()}});
startBtn.addEventListener("click",startMatch);pauseBtn.addEventListener("click",togglePause);resetBtn.addEventListener("click",resetMatch);
playAgainBtn.addEventListener("click",startMatch);newMatchBtn.addEventListener("click",()=>{resetMatch();document.querySelector(".match-control-panel").scrollIntoView({behavior:"smooth",block:"start"})});
matchSpeedSelect.addEventListener("change",refreshMatchTimer);
pitchStyleSelect.addEventListener("change",()=>drawPitch());
showCommentaryCheckbox.addEventListener("change",()=>{commentaryPanel.hidden=!showCommentaryCheckbox.checked});
showSquadsCheckbox.addEventListener("change",()=>{squadsPanel.hidden=!showSquadsCheckbox.checked});
showLabelsCheckbox.addEventListener("change",()=>drawPitch());
resetMatch();animationLoop();
</script>
</body>
</html>
