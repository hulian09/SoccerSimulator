<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Soccer Match Simulator — Updated Edition</title>
<style>
:root{color-scheme:dark;--bg:#0b1118;--panel:#141e29;--panel2:#192634;--line:#2a3b4c;--muted:#9aabba;--text:#edf4fb;--accent:#79e2a2;--accent2:#45b778;--gold:#ffce6b}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 50% -25%,#243b4b 0%,var(--bg) 60%);color:var(--text);font:15px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;min-height:100vh}
button,select,input{font:inherit}
button,select{border:1px solid #3a4e61;background:#202e3d;color:var(--text);border-radius:10px;padding:10px 13px}
select{max-width:100%;cursor:pointer}
button{cursor:pointer;font-weight:750;transition:transform .15s ease,border-color .15s ease,background .15s ease}
button:hover{background:#2a3b4b;border-color:#6c8295;transform:translateY(-1px)}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
button.primary{background:var(--accent);border-color:var(--accent);color:#092015}
button.primary:hover{background:#9bf0ba;border-color:#9bf0ba}
button.secondary{background:#243648}
button:disabled{opacity:.45;cursor:not-allowed;transform:none}
.app-shell{max-width:1320px;margin:0 auto;padding:24px clamp(12px,2.5vw,30px) 38px}
.app-header{text-align:center;margin:0 auto 22px;max-width:800px}
.eyebrow{color:var(--accent);font-size:11px;font-weight:850;letter-spacing:.22em;text-transform:uppercase;margin-bottom:8px}
h1{font-size:clamp(27px,4vw,42px);line-height:1.08;letter-spacing:-.04em;margin:0 0 10px;font-weight:900}
.app-header p{color:var(--muted);margin:0;font-size:14px}
.panel{background:linear-gradient(145deg,rgba(25,38,51,.97),rgba(17,27,38,.98));border:1px solid var(--line);border-radius:17px;box-shadow:0 16px 40px rgba(0,0,0,.16);padding:16px;margin-top:15px}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 12px}
.section-heading h2,.panel h2{font-size:15px;letter-spacing:.01em;margin:0;font-weight:850}
.section-kicker{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:800}
.match-control-panel{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:end}
.match-pickers{display:grid;grid-template-columns:1fr auto 1fr;align-items:end;gap:10px}
.team-picker{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:11px;letter-spacing:.09em;text-transform:uppercase;font-weight:850;min-width:0}
.team-picker select{width:100%;font-size:14px;text-transform:none;letter-spacing:normal;font-weight:700;color:var(--text)}
.vs-mark{color:#6d8192;font-size:12px;font-weight:900;padding-bottom:13px}
.match-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}
.scoreboard{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:20px;align-items:center;padding:21px 16px;margin-top:15px;border-radius:18px;background:linear-gradient(120deg,#172633,#1d2c38 50%,#172633);border:1px solid #344756;box-shadow:inset 0 1px rgba(255,255,255,.035)}
.score-team{min-width:0;display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center}
.score-team .team-name{font-size:clamp(14px,2vw,20px);font-weight:850;letter-spacing:-.02em;overflow-wrap:anywhere}
.kit-dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:7px;box-shadow:0 0 0 3px rgba(255,255,255,.06)}
.score-numbers{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:120px}
.score{font-size:clamp(37px,6vw,58px);font-weight:950;letter-spacing:-.065em;line-height:1;font-variant-numeric:tabular-nums}
.score-caption{font-size:10px;color:var(--muted);letter-spacing:.2em;font-weight:900}
.match-meta{display:flex;justify-content:center;align-items:center;gap:12px;margin:12px 0 10px}
.timer{font-size:20px;line-height:1;font-weight:900;letter-spacing:.08em;font-variant-numeric:tabular-nums}
.status-pill{display:inline-flex;align-items:center;gap:7px;border:1px solid #405363;border-radius:999px;padding:5px 10px;font-size:10px;letter-spacing:.13em;font-weight:900;color:#a7b7c5;background:#1b2936}
.status-pill::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.status-pill.live{color:var(--accent);border-color:#38664d}.status-pill.finished{color:var(--gold);border-color:#685937}
.game-area{background:#111a24;border:1px solid #2b3d4c;border-radius:18px;padding:10px;box-shadow:0 18px 45px rgba(0,0,0,.25)}
canvas{display:block;width:100%;height:auto;aspect-ratio:1000/620;border:1px solid rgba(255,255,255,.15);border-radius:11px;background:#28753e;box-shadow:0 5px 15px rgba(0,0,0,.16)}
.pitch-footer{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:9px 3px 0;color:var(--muted);font-size:11px}
.legend{display:flex;gap:13px;align-items:center;flex-wrap:wrap}.legend-item{display:inline-flex;align-items:center;gap:6px}.legend-swatch{width:9px;height:9px;border:1px solid rgba(255,255,255,.7);border-radius:50%;display:inline-block}
.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}
.panel-heading h2{font-size:15px;margin:0}
.panel-heading .helper{color:var(--muted);font-size:11px}
.settings-panel details{padding:0}
.settings-panel summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px;font-weight:850}
.settings-panel summary::-webkit-details-marker{display:none}
.settings-panel summary::after{content:"＋";color:var(--accent);font-size:18px}
.settings-panel details[open] summary::after{content:"−"}
.settings-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:17px}
.setting-control{display:flex;flex-direction:column;gap:7px;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:850;min-width:0}
.setting-control select{width:100%;font-size:13px;text-transform:none;letter-spacing:normal;font-weight:650}
.setting-toggle{display:flex;align-items:center;gap:8px;border:1px solid #2e4050;background:#172431;padding:10px 11px;border-radius:10px;color:#d7e1e9;font-size:12px;font-weight:700;letter-spacing:0;text-transform:none;min-height:42px}
.setting-toggle input{accent-color:var(--accent);width:16px;height:16px;margin:0}
#commentary{max-height:300px;min-height:60px;overflow:auto;display:flex;flex-direction:column;gap:7px;padding-right:3px}
.event{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border:1px solid #293b4a;border-radius:10px;background:#172431;font-size:13px;line-height:1.35}
.event-time{flex:0 0 30px;color:#a6bac9;font-weight:900;font-variant-numeric:tabular-nums}
.event-copy{min-width:0;overflow-wrap:anywhere}.event.goal{border-color:#326548;background:#192f27}.event.goal .event-time{color:#8af0b0}.event.ht{border-color:#63512b;background:#30291b}.event.ft{border-color:#35576e;background:#1a2b3b}.event.sub{border-color:#344d68}.event.injury{border-color:#70473b;background:#30231f}
.squads{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.squad{border:1px solid #2c3d4b;border-radius:12px;background:#16222e;padding:13px;min-width:0;font-size:12px;line-height:1.7;color:#c8d4de;overflow-wrap:anywhere}
.squad h3{margin:0;font-size:15px;color:var(--text)}
.squad-title{display:flex;align-items:center;justify-content:space-between;gap:9px;margin-bottom:9px}
.formation-tag{font-size:10px;color:var(--accent);border:1px solid #2e6045;border-radius:999px;padding:2px 7px;font-weight:900;letter-spacing:.06em;white-space:nowrap}
.squad strong{display:block;margin:12px 0 4px;color:#e3ebf2;font-size:10px;letter-spacing:.1em;text-transform:uppercase}
.squad .starter-list{display:grid;grid-template-columns:1fr;gap:1px}.squad .starter{padding:1px 0}.squad .role{display:inline-block;min-width:38px;padding-right:5px;color:#90a7b8;font-size:10px;font-weight:900}
.summary-panel{border-color:#3c624d;background:linear-gradient(145deg,#172b24,#14232a)}
.summary-panel[hidden], [hidden]{display:none!important}
.summary-top{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;padding-bottom:13px;border-bottom:1px solid #315344}
.summary-label{color:var(--accent);font-size:10px;font-weight:950;letter-spacing:.18em;text-transform:uppercase}
.summary-top h2{font-size:20px;margin:3px 0 0}
.summary-score{font-size:30px;letter-spacing:-.04em;font-weight:950;font-variant-numeric:tabular-nums}
.summary-buttons{display:flex;gap:8px;flex-wrap:wrap}
.stats-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:14px 0}
.stat-card{background:rgba(8,19,16,.28);border:1px solid #315041;border-radius:11px;padding:11px;text-align:center;min-width:0}
.stat-value{font-size:21px;font-weight:950;line-height:1.1;font-variant-numeric:tabular-nums}.stat-label{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#a9bdb4;font-weight:850;margin-top:5px}
.summary-columns{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.summary-section{border:1px solid #315041;border-radius:11px;padding:12px;background:rgba(8,19,16,.2);min-width:0}
.summary-section h3{font-size:12px;margin:0 0 9px;text-transform:uppercase;letter-spacing:.08em}
.summary-list{margin:0;padding-left:22px;color:#d9e6dd;font-size:13px}.summary-list li{padding:3px 0;overflow-wrap:anywhere}.summary-list .muted{color:#9eb3a7}
.empty-state{color:#9eb3a7;font-size:12px}
.footer-note{text-align:center;color:#718596;font-size:11px;margin-top:16px}
@media(max-width:850px){.match-control-panel{grid-template-columns:1fr}.match-actions{justify-content:flex-start}.settings-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.scoreboard{gap:10px}.score-numbers{min-width:100px}}
@media(max-width:560px){.app-shell{padding:17px 10px 26px}.panel{padding:12px;border-radius:13px}.match-pickers{grid-template-columns:1fr 24px 1fr;gap:6px}.team-picker select{padding:9px 6px;font-size:12px}.vs-mark{text-align:center}.match-actions button{flex:1;padding:9px 8px;font-size:12px}.scoreboard{padding:17px 8px;gap:3px}.score-team .team-name{font-size:12px}.kit-dot{width:7px;height:7px;margin-right:4px}.score{font-size:39px}.score-numbers{min-width:84px}.timer{font-size:18px}.game-area{padding:5px;border-radius:13px}.pitch-footer{padding:8px 2px 2px}.settings-grid{grid-template-columns:1fr 1fr;gap:8px}.setting-control select{padding:9px 7px;font-size:12px}.setting-toggle{padding:8px;font-size:11px}.squads{grid-template-columns:1fr}.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stat-card:last-child{grid-column:1/-1}.summary-columns{grid-template-columns:1fr}.summary-score{font-size:25px}.summary-buttons{width:100%}.summary-buttons button{flex:1}}
@media(prefers-reduced-motion:reduce){button{transition:none}}
</style>
</head>
<body>
<div class="app-shell">
  <header class="app-header">
    <div class="eyebrow">Matchday simulation engine</div>
    <h1>⚽ Soccer Match Simulator</h1>
    <p>Pick two teams, set your match style, and watch the 90 minutes unfold.</p>
  </header>

  <section class="panel match-control-panel" aria-label="Match controls">
    <div class="match-pickers">
      <label class="team-picker" for="homeSelect">Home team<select id="homeSelect"></select></label>
      <div class="vs-mark" aria-hidden="true">VS</div>
      <label class="team-picker" for="awaySelect">Away team<select id="awaySelect"></select></label>
    </div>
    <div class="match-actions">
      <button id="startBtn" class="primary" type="button">▶ Start Match</button>
      <button id="pauseBtn" class="secondary" type="button">Ⅱ Pause</button>
      <button id="resetBtn" type="button">↻ Reset</button>
    </div>
  </section>

  <section class="scoreboard" aria-label="Live score">
    <div class="score-team"><div id="homeKit" class="team-name"><span class="kit-dot"></span><span id="homeName">Barcelona</span></div><div class="section-kicker">Home</div></div>
    <div class="score-numbers"><div id="score" class="score">0 - 0</div><div class="score-caption">SCORE</div></div>
    <div class="score-team"><div id="awayKit" class="team-name"><span class="kit-dot"></span><span id="awayName">Real Madrid</span></div><div class="section-kicker">Away</div></div>
  </section>
  <div class="match-meta"><div id="timer" class="timer">00:00</div><div id="statusPill" class="status-pill">READY</div></div>

  <section class="game-area" aria-label="Animated football pitch">
    <canvas id="pitch" width="1000" height="620" role="img" aria-label="Animated soccer match pitch with player markers and ball"></canvas>
    <div class="pitch-footer">
      <div class="legend"><span class="legend-item"><span id="homeLegend" class="legend-swatch" style="background:#a50044"></span><span id="homeLegendName">Barcelona</span></span><span class="legend-item"><span id="awayLegend" class="legend-swatch" style="background:#183b72"></span><span id="awayLegendName">Real Madrid</span></span></div>
      <span>Marker text = position · Names can be toggled below</span>
    </div>
  </section>

  <section id="matchSummary" class="panel summary-panel" hidden aria-live="polite">
    <div class="summary-top">
      <div><div class="summary-label">Full time</div><h2 id="summaryTitle">Match report</h2></div>
      <div id="summaryScore" class="summary-score">0 – 0</div>
      <div class="summary-buttons"><button id="playAgainBtn" class="primary" type="button">▶ Play Again</button><button id="newMatchBtn" type="button">New Match</button></div>
    </div>
    <div id="summaryStats" class="stats-grid"></div>
    <div class="summary-columns">
      <section class="summary-section"><h3>Goal timeline</h3><ol id="summaryGoals" class="summary-list"></ol></section>
      <section class="summary-section"><h3>Key moments</h3><ol id="summaryEvents" class="summary-list"></ol></section>
    </div>
  </section>

  <section class="panel settings-panel">
    <details id="settingsDetails">
      <summary><span>Customize your match</span><span class="section-kicker">Pace · scoring · pitch · display</span></summary>
      <div class="settings-grid">
        <label class="setting-control" for="matchSpeedSelect">Match speed<select id="matchSpeedSelect"><option value="750">Slow · ~69 sec</option><option value="500" selected>Normal · ~46 sec</option><option value="300">Fast · ~28 sec</option></select></label>
        <label class="setting-control" for="goalRateSelect">Match style<select id="goalRateSelect"><option value="0.82">Tactical · fewer chances</option><option value="1" selected>Balanced</option><option value="1.22">Open game · more chances</option></select></label>
        <label class="setting-control" for="pitchStyleSelect">Pitch look<select id="pitchStyleSelect"><option value="classic" selected>Classic green</option><option value="stripes">Bold stripes</option><option value="night">Night match</option></select></label>
        <label class="setting-toggle"><input id="showLabelsCheckbox" type="checkbox" checked> Show player surnames</label>
        <label class="setting-toggle"><input id="showCommentaryCheckbox" type="checkbox" checked> Show live commentary</label>
        <label class="setting-toggle"><input id="showSquadsCheckbox" type="checkbox" checked> Show team squads</label>
      </div>
    </details>
  </section>

  <section id="commentaryPanel" class="panel">
    <div class="panel-heading"><h2>Live commentary</h2><span class="helper">Newest events appear first</span></div>
    <div id="commentary" aria-live="polite" aria-relevant="additions"></div>
  </section>

  <section id="squadsPanel" class="panel">
    <div class="panel-heading"><h2>Selected squads</h2><span class="helper">Starters and position-matched backups</span></div>
    <div class="squads"><div id="homeSquad" class="squad"></div><div id="awaySquad" class="squad"></div></div>
  </section>
  <div class="footer-note">A self-contained match simulator · No external libraries required</div>
</div>
